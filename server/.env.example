# LawnMind API server configuration. Copy to .env (or export in your shell).
# Every value has a safe default — the server runs with no .env at all.

# PORT=3001
# HOST=0.0.0.0

# Browser origins allowed by CORS (comma-separated).
# CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Anthropic API key — server-side only, never shipped to the client.
# Without it the chat agent runs in deterministic offline demo mode.
# ANTHROPIC_API_KEY=sk-ant-...

# Claude model for the chat agent (PRD specifies the Sonnet tier).
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Weather upstream + cache.
# WEATHER_API_BASE=https://api.open-meteo.com
# WEATHER_CACHE_TTL_SECONDS=1800

# Abuse limits (per IP per minute).
# RATE_LIMIT_MAX=120
# CHAT_RATE_LIMIT_MAX=20
